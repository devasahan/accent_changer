{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Accent Changer",
  "version": "0.1.0",
  "identifier": "io.github.devasahan.accentchanger",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:8080/src/",
    "beforeBuildCommand": "node scripts/copy-frontend.mjs"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; media-src 'self' blob: mediastream:; connect-src 'self' ipc: http://ipc.localhost https://portal-api.sanas.ai https://event-producer.sanas.ai wss:; object-src 'none'; base-uri 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Accent Changer",
    "shortDescription": "A live US accent for your own interview calls",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "windows": {
      "minimumWebview2Version": "110.0.1587.40",
      "webviewInstallMode": { "type": "downloadBootstrapper", "silent": true },
      "nsis": { "installMode": "currentUser" }
    }
  }
}
